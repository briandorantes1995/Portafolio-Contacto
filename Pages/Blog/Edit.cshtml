@page "{id:int}"
@model Portafolio.Pages.Blog.EditModel

<div class="container">

    <a asp-page="/Blog/Details" asp-route-id="@RouteData.Values["id"]">&larr; Volver al post</a>

    <p class="mt-3">Editar Post</p>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Input.Title">Titulo</label>
            <input asp-for="Input.Title" class="form-control" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Summary">Resumen</label>
            <input asp-for="Input.Summary" class="form-control" />
            <span asp-validation-for="Input.Summary" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Content">Contenido</label>
            <textarea asp-for="Input.Content" class="form-control" rows="12"></textarea>
            <span asp-validation-for="Input.Content" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CoverImage">Imagen de portada</label>
            @if (!string.IsNullOrEmpty(Model.CurrentCoverImageUrl))
            {
                <div><img src="@Model.CurrentCoverImageUrl" width="240" class="img-fluid my-2" alt="Portada actual" /></div>
                <small class="text-muted">Sube una imagen solo si quieres reemplazar la actual.</small>
            }
            <input asp-for="CoverImage" type="file" accept="image/*" class="form-control" />
            <span asp-validation-for="CoverImage" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.PublishedAt">Fecha de publicacion</label>
            <input asp-for="Input.PublishedAt" type="date" class="form-control" />
            <small class="text-muted">Dejala vacia para guardarlo como borrador.</small>
            <span asp-validation-for="Input.PublishedAt" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
